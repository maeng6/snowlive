<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1C1C1E">

    <!-- 상단: 로고 (좌측) + 리조트명/타이머 (우측) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- SNOWLIVE 로고 (좌측) -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="70dp"
            android:layout_height="12dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/img_liveactivity_logo_dark"
            android:scaleType="fitStart" />

        <!-- 리조트명 + 타이머 (우측) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 핀 아이콘 -->
            <ImageView
                android:id="@+id/pin_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/img_liveactivity_pin"
                android:layout_marginEnd="2dp" />

            <!-- 리조트명 -->
            <TextView
                android:id="@+id/resort_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="휘닉스파크"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <!-- 타이머 -->
            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 하단: 3개 컬럼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 라이딩 횟수 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="라이딩 횟수"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <TextView
                android:id="@+id/ride_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 라이브온 중인 친구 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="라이브온 중인 친구"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <TextView
                android:id="@+id/friend_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 마지막 라이딩 슬로프 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마지막 라이딩 슬로프"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <TextView
                android:id="@+id/last_slope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
