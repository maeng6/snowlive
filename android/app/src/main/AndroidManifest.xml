<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.snowlive">

    <!-- 하드웨어 기능을 '필수'가 아닌 '선택'으로 명시 — 세로고정/플러그인이 자동으로
         required=true로 선언해 Play 콘솔이 설치 가능 기기를 좁힌다는 경고를 띄운다.
         wifi 없는 기기/Desktop/XR에도 설치되도록 required=false로 덮어쓴다. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- 권한 설정 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 배터리 최적화 제외 요청 권한 (백그라운드 위치 서비스 안정적 실행) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 카카오톡/네이버앱 설치 확인(Android 11+ 패키지 가시성) -->
    <queries>
        <package android:name="com.kakao.talk" />
        <package android:name="com.nhn.android.search" />
    </queries>

    <!-- 앱 설정 -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:label"
        android:label="스노우라이브"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">

        <!-- 기본 알림 채널 설정 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />

        <!-- 카카오 로그인 리다이렉트(카카오계정 웹 로그인 복귀) -->
        <activity
            android:name="com.kakao.sdk.flutter.AuthCodeCustomTabsActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- kakao{NATIVE_APP_KEY}://oauth -->
                <data android:scheme="kakaofdf31779d822436a2a29a68b19619e45" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- 네이버 로그인 SDK 설정 -->
        <meta-data android:name="com.naver.sdk.clientId" android:value="@string/naver_client_id" />
        <meta-data android:name="com.naver.sdk.clientSecret" android:value="@string/naver_client_secret" />
        <meta-data android:name="com.naver.sdk.clientName" android:value="@string/naver_client_name" />

        <!-- 메인 액티비티 설정 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Flutter 기본 설정 -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- 앱 실행(MAIN/LAUNCHER) 필터는 아래 activity-alias(DefaultAlias)로 이동.
                 → 대체 아이콘 전환을 위해 '런처 역할'을 alias에 두고, 변형별 alias를
                 enable/disable로 교체한다. (MainActivity 자체는 항상 enabled=target) -->

            <!-- Flutter 푸시 알림 클릭 인텐트 필터 -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

            <!-- PaceFace 딥링크 인텐트 필터 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="snowlive" />
            </intent-filter>
        </activity>

        <!-- ── 대체 런처 아이콘(activity-alias) ──
             홈화면 아이콘은 '빌드에 미리 번들된' 아이콘 중에서만 전환 가능.
             DefaultAlias(기본)만 enabled=true로 시작하고, 변형(Xmas/Opening)은
             enabled=false. 서버(check-wb)의 app_icon_variant → MainActivity의
             'app_icon' 채널이 선택 alias만 enable, 나머지 disable(항상 1개만 켜짐).
             변형 아이콘(@mipmap/launcher_icon_xmas 등)은 현재 플레이스홀더이며
             디자이너 아트로 교체 예정. -->
        <activity-alias
            android:name=".DefaultAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/launcher_icon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".XmasAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/launcher_icon_xmas"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".NewyearAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/launcher_icon_newyear"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- 알림 관련 메타 데이터 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data android:name="com.transistorsoft.locationmanager.license" android:value="50381855bd42ab868e695ed0505c45399dccb50b20bd97a791994898b1fcf8eb"/>

        <!-- 기타 액티비티 설정 -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <!-- 포어그라운드 서비스 설정 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:foregroundServiceType="location" />

        <!-- 라이브 액티비티 서비스 (라이브온 상태 알림 표시) -->
        <service
            android:name=".LiveActivityService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 알림 채널 설정 (포어그라운드 서비스용) -->
        <meta-data
            android:name="com.google.android.gms.location"
            android:value="default_notification_channel_id" />

    </application>

    <queries>
        <package android:name="com.paceface" />
    </queries>

</manifest>
